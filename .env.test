# Test Database Configuration
TEST_MYSQL_ROOT_PASSWORD=test_rootpassword
TEST_MYSQL_DATABASE=online_shop
TEST_MYSQL_USER=shopuser
TEST_MYSQL_PASSWORD=test_userpassword
TEST_MYSQL_PORT=3307
TEST_PATTERN=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://192.168.100.82:8000,http://192.168.100.82:3000,http://localhost:3001,http://localhost:8001

# JWT Configuration
JWT_SECRET_KEY=test-secret-key-for-testing
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie-based auth configuration for tests
# In tests we usually rely on defaults:
#   - COOKIE_SECURE: false (ENVIRONMENT=test)
#   - COOKIE_SAMESITE: "lax"
#   - COOKIE_DOMAIN: not set
#   - COOKIE_PATH: "/"
# You can uncomment these to explicitly control cookie behavior in tests:
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# COOKIE_PATH=/

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass123

ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8001,localhost:3001,api_server_test

# Reverse proxy / forwarded headers configuration for tests
# Integration tests talk directly to the API container, so we typically do NOT
# want to trust X-Forwarded-* headers in the test environment.
USE_PROXY_HEADERS=false
# FORWARDED_ALLOW_IPS can be set if you introduce a proxy in front of the test API.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Order creation rate limit: test compose uses ORDER_RATE_LIMIT_MAX=1000 by default.
# See docs/ORDER_RATE_LIMIT.md for valid values.
# ORDER_RATE_LIMIT_MAX=1000
# ORDER_RATE_LIMIT_WINDOW=24hour

# Admin login brute-force protection (per-IP) for tests.
# Limit = LOGIN_RATE_LIMIT_MAX / LOGIN_RATE_LIMIT_WINDOW (no space).
# docker-compose.test.yml defaults to a high ceiling so tests don't hit it:
#   LOGIN_RATE_LIMIT_MAX=1000
#   LOGIN_RATE_LIMIT_WINDOW=5minute
# LOGIN_RATE_LIMIT_MAX=1000
# LOGIN_RATE_LIMIT_WINDOW=5minute

# VAPID for tests
TEST_VAPID_PUBLIC_KEY=BOe2k7srNl1rTt1y_1l3VBo3qk4n6B1k9E9oV8zqj5sRrVg6q1bK42NzfQ9oYd0z7qf6e5XjT1dD2C3B4A5c6dE
TEST_VAPID_PRIVATE_KEY=QWERTYUIOPASDFGHJKLZXCVBNM1234567890abcd
TEST_VAPID_SUBJECT=mailto:test@example.com

TEST_FRONTEND_URL=http://localhost:3000
