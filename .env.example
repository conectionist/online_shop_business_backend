# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=online_shop
MYSQL_USER=shopuser
MYSQL_PASSWORD=userpassword
MYSQL_PORT=3306
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT Configuration
JWT_SECRET_KEY=your-secure-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie-based auth configuration
# These control how JWT cookies are issued by the backend.
# If unset, defaults from app/core/config.py are used:
#   - COOKIE_SECURE: true when ENVIRONMENT=production, false otherwise
#   - COOKIE_SAMESITE: "lax"
#   - COOKIE_DOMAIN: not set (cookie bound to current host)
#   - COOKIE_PATH: "/"
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=api.example.com
# COOKIE_PATH=/api

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass123

# Trusted Hosts for FastAPI TrustedHostMiddleware. In production set to your API host(s), e.g. api.example.com (not *)
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8000,localhost:3000

# Reverse proxy / forwarded headers configuration
# When running behind a trusted reverse proxy (e.g. Caddy, Nginx), keep USE_PROXY_HEADERS=true
# and set FORWARDED_ALLOW_IPS to the IP(s) of your proxy, as the API container sees them.
# The order and login rate limits count per client IP: if the proxy is not listed, every
# customer shares one limit (the API logs a warning when it sees this).
# Never use "*": clients could then choose their own IP. If you list the Docker gateway
# (e.g. 172.18.0.1), keep port 8000 unreachable except through the proxy.
# Production refuses to start unless USE_PROXY_HEADERS is true and FORWARDED_ALLOW_IPS lists
# IP addresses or networks other than loopback. To find the proxy's address: the proxy
# container's IP, or the network's gateway (docker network inspect <network>) if the proxy
# runs on the host.
# For local development without a proxy, you can set USE_PROXY_HEADERS=false to ignore X-Forwarded-* headers.
# USE_PROXY_HEADERS=true
# FORWARDED_ALLOW_IPS=172.18.0.1

# Image upload: max file size in MB for product/category images (default 15)
# MAX_IMAGE_SIZE_MB=15

# Order creation rate limit (per-IP). Applied to POST /api/v1/orders/ only.
# Limit = ORDER_RATE_LIMIT_MAX / ORDER_RATE_LIMIT_WINDOW (no space). See docs/ORDER_RATE_LIMIT.md.
# ORDER_RATE_LIMIT_MAX=10
# ORDER_RATE_LIMIT_WINDOW=24hour

# Admin login brute-force protection (per-IP). Applied to POST /api/v1/auth/login only.
# Limit = LOGIN_RATE_LIMIT_MAX / LOGIN_RATE_LIMIT_WINDOW (no space).
# Defaults (if unset) are:
#   - ENVIRONMENT=production: 5/5minute
#   - other environments: 1000/5minute
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW=5minute

# Redis Configuration
# REDIS_HOST and REDIS_PORT are set in docker-compose.yml.
# Override here only for non-Docker environments.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=change-me-strong-redis-password

# Metrics endpoint protection in tests
ENABLE_METRICS=true
METRICS_AUTH_REQUIRED=true
METRICS_BEARER_TOKENS=test-metrics-token

FRONTEND_URL=http://localhost:3001

# Public origin of this API, used for absolute links such as the Google Merchant feed's
# image URLs. Required in production as a public https URL, and so is FRONTEND_URL: the
# API sits behind a proxy there, so the request's own origin is not the public one.
# Leave empty in dev/test.
# PUBLIC_API_URL=https://api.example.com

