FROM python:3.11-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy test script
COPY test/db/docker_test_db_connection.py .

# Make the script executable
RUN chmod +x docker_test_db_connection.py

# Run the test script
CMD ["python", "docker_test_db_connection.py"]
